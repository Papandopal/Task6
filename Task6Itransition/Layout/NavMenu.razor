@code {
	[Parameter]
	public string Action { get; set; } = string.Empty;

	[Parameter]
	public EventCallback<string> ActionChanged { get; set; }

	private async Task ValueChangedHandler(string value)
	{
		Action = value;
		await ActionChanged.InvokeAsync(Action);
	}
}
